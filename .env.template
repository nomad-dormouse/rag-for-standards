# Directories and files names
PROJECT_DIR_NAME=rag_for_standards
STORAGE_DIR_NAME=rag_storage
STANDARDS_DIR_NAME=standards
INDEX_DIR_NAME=index
WEBAPP_DIR_NAME=rag_webapp
CONTAINER_WORKDIR_NAME=app
STORAGE_DOCKERFILE_NAME=dockerfile_storage
WEBAPP_DOCKERFILE_NAME=dockerfile_webapp
STORAGE_REQUIREMENTS_NAME=requirements_storage.txt
WEBAPP_REQUIREMENTS_NAME=requirements_webapp.txt
INGESTION_FILE_NAME=ingestion.py
PARSED_PAGES_FILE_NAME=parsed_pages.pkl
PARSING_RESULTS_FILE_NAME=parsing_results.csv
REPORT_FILE_NAME=ingestion_report.json

# OCR
TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata
MIN_TEXT_THRESHOLD=100

# Language model and RAG
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SIMILARITY_TOP_K=5
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_TEMPERATURE=0.0
SYSTEM_PROMPT="You are a helpful assistant who answers questions about Ukrainian standards for technical documentation. Always respond in the same language as the question (Ukrainian or English). If the question includes both languages, reply in the primary language of the question body. Wherever possible, cite the specific Ukrainian technical standard(s) (e.g. DSTU, GOST) that support your answer. If no relevant standard is found, explain that explicitly and suggest possible related standards."
CONTEXT_PROMPT="Use the following retrieved context to answer the user's question:"
QUESTION_PROMPT="User question:"
ANSWER_PROMPT="Your answer (based on the context above):"

# Webapp
WEBAPP_PORT=8501
STREAMLIT_SERVER_FILE_WATCHER_TYPE=none
STREAMLIT_SERVER_HEADLESS=true
PYTHONUNBUFFERED=1
DEFAULT_INTERFACE_LANGUAGE=en

# Docker
COMPOSE_PROJECT_NAME=rag_for_standards
DOCKER_NETWORK_NAME=rag_network
INDEX_VOLUME_NAME=rag_index_volume
STORAGE_BUILD_NAME=rag_storage_build
WEBAPP_BUILD_NAME=rag_webapp_build
STORAGE_IMAGE_NAME=rag_storage_image
WEBAPP_IMAGE_NAME=rag_webapp_image
STORAGE_CONTAINER_NAME=rag_storage_container
WEBAPP_CONTAINER_NAME=rag_webapp_container
STORAGE_SERVICE_NAME=rag_storage_service
WEBAPP_SERVICE_NAME=rag_webapp_service

# Server configuration
REMOTE_HOST=your-server-ip
REMOTE_USER=your-remote-user
REMOTE_DIR=rag-for-standards
SSH_KEY=${HOME}/.ssh/your-key-name
REPO_URL=https://github.com/your-git-name/your-repo-name.git

# Terminal
DELIMITER_LENGTH=100
NC='\033[0m'
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[;33m'
BLUE='\033[0;34m'