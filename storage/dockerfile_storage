# Base image
FROM python:3.11-slim

# Copy files from local parent directory to container's working directory
ARG CONTAINER_WORKDIR_NAME
WORKDIR /${CONTAINER_WORKDIR_NAME}
COPY . .

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        curl \
        git \
    && apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install Python dependencies
ARG STORAGE_REQUIREMENTS_NAME
RUN pip install --upgrade pip && \
    pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-cache-dir -r ${STORAGE_REQUIREMENTS_NAME} && \
    rm -rf /root/.cache/pip

# Pre-download the embedding model to avoid runtime download issues
ARG EMBEDDING_MODEL_NAME
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('${EMBEDDING_MODEL_NAME}')" || \
    echo "Warning: Could not pre-download model ${EMBEDDING_MODEL_NAME}, will try at runtime"

# Set environment variables for offline mode fallback
ARG TRANSFORMERS_OFFLINE
ARG HF_HUB_OFFLINE
ENV TRANSFORMERS_OFFLINE=${TRANSFORMERS_OFFLINE}
ENV HF_HUB_OFFLINE=${HF_HUB_OFFLINE}

# Create volume mount points
VOLUME ["/${CONTAINER_WORKDIR_NAME}/index"]

# Run standards ingestion
CMD ["python", "ingest.py"]